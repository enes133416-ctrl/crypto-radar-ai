# Bu dosyayı ".env" olarak kopyalayın. .env dosyasını ASLA GitHub'a yüklemeyin.
# Binance herkese açık piyasa verileri için API key GEREKTİRMEZ.
RUN_MODE=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/crypto_radar.db
DEMO_MODE=false
LOG_LEVEL=INFO
MIN_QUOTE_VOLUME_24H=5000000
MAX_SPREAD_PCT=0.30

# Veri toplayıcı (Aşama 2)
COLLECTOR_ENABLED=true
MAX_SYMBOLS_PER_MARKET=60
TRACKED_INTERVALS=15m,1h,4h,1d
BACKFILL_LIMIT=300
# Binance bölgenizde engelliyse (HTTP 451) Spot için alternatif herkese açık adres:
# BINANCE_SPOT_REST=https://data-api.binance.vision
