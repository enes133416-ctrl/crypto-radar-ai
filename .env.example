# Bu dosyayı proje kökünde .env olarak kopyalayın. .env GitHub'a YÜKLENMEZ.
# Binance herkese açık piyasa verileri için API key/secret GEREKMEZ; bu projede key alanı yoktur.
RUN_MODE=local
DEMO_MODE=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/crypto_radar.db

# Veri toplama / sürekli tarama
COLLECTOR_ENABLED=true
SCANNER_ENABLED=true
MAX_SYMBOLS_PER_MARKET=60
TRACKED_INTERVALS=5m,15m,1h,4h,1d
BACKFILL_LIMIT=300
SCAN_INTERVAL_SECONDS=300
DISCOVERY_INTERVAL_SECONDS=900
OUTCOME_INTERVAL_SECONDS=900
SCAN_ORDERBOOK_CONCURRENCY=6

# Zorunlu risk filtreleri ve sinyal kaydı
MIN_QUOTE_VOLUME_24H=5000000
MAX_SPREAD_PCT=0.30
MIN_ORDERBOOK_DEPTH_QUOTE=50000
MAX_ATR_PCT=12
EXTREME_FUNDING_RATE=0.001
CRITICAL_FUNDING_RATE=0.003
MIN_LISTING_AGE_DAYS=30
MAX_SPOT_FUTURES_PRICE_DIFF_PCT=2
VOLUME_EXPLOSION_RATIO=2.5
SIGNAL_MIN_SCORE=50
SIGNAL_COOLDOWN_HOURS=4
ROUND_TRIP_COST_PCT=0.15

# Ayrı komutla eğitilen hafif ML modeli
MODEL_PATH=./data/models/opportunity_models.joblib
ML_MIN_SAMPLES=200
API_RATE_LIMIT_PER_MINUTE=240

# Binance bölgenizde HTTP 451 verirse Spot için alternatif herkese açık adres:
# BINANCE_SPOT_REST=https://data-api.binance.vision
# BINANCE_SPOT_REST=https://api.binance.com
# BINANCE_FUTURES_REST=https://fapi.binance.com
# BINANCE_SPOT_WS=wss://stream.binance.com:9443
# BINANCE_FUTURES_WS=wss://fstream.binance.com

# Frontend ayrı statik hostingdeyse BUILD SIRASINDA verilir (örnek):
# VITE_API_BASE=https://crypto-radar-api.example.com
# Yerel Vite geliştirmede boş bırakın; /api otomatik proxy'lenir.
